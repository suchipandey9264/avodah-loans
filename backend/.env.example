# Copy to .env and adjust.
PORT=4000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# true = accept any 6-digit OTP and return it in the response (demo only). Set false once an SMS provider is wired in.
OTP_DEMO=true
# MongoDB connection string (Atlas or local) and database name.
MONGO_DB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB_NAME=avodahloans
