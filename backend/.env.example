# Copy to .env and adjust.
PORT=4000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# true = accept any 6-digit OTP and return it in the response (demo only). Set false once an SMS provider is wired in.
OTP_DEMO=true
# MongoDB connection string (Atlas or local) and database name.
MONGO_DB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB_NAME=avodahloans

# Cloudflare Turnstile captcha (https://dash.cloudflare.com → Turnstile). Leave empty to turn captcha off.
# The value below is Cloudflare's TEST secret: every check passes. Use your real secret in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Set to 1 when running behind one proxy/load balancer (Render, Nginx) so rate limits use the visitor's IP.
TRUST_PROXY=0
